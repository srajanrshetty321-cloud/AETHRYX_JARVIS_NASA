# GEMINI_API_KEY: Required for server-side Gemini AI scientific assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server listening port (must remain 3000 in AI Studio / Cloud Run preview).
PORT=3000

# SESSION_SECRET: HMAC signing secret for persistent investigator session cookies.
# Leave unset to auto-generate a secure runtime secret (set explicitly for multi-instance Cloud Run).
SESSION_SECRET=""

# EARTHDATA_TOKEN: Optional NASA Earthdata Login Bearer Token for direct GES DISC / LP DAAC OPeNDAP data subsetting (MERRA-2, GPM IMERG, MODIS, AIRS, OMI, GLDAS).
# Obtain from https://urs.earthdata.nasa.gov/user_tokens
EARTHDATA_TOKEN=""

# DB_PATH: Optional path to SQLite database file (defaults to ./data/aethryx.db, falls back to /tmp/aethryx.db if read-only).
DB_PATH="./data/aethryx.db"
